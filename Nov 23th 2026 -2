from picarx import Picarx
import time
import readchar
from vilib import Vilib
n=0
print("Enter http://name.local:9000/mjpg.")
print(" for quit press q")
Vilib.camera_start(vflip=False, hflip=False, resolution=(320, 240), framerate=30)
Vilib.display(local=False, web=True)



px= Picarx()
while True:
    key = readchar.readkey().lower()
    if key == 'w':
        px.forward(30)
        time.sleep(0.5)
        px.stop()
    elif key == 's':
        px.backward(30)
        time.sleep(0.5)
        px.stop()
    elif key == 'a':
        px.turn_left(30)
        px.forward(30)
        time.sleep(0.5)
        px.stop()
    elif key == 'd':
        px.turn_right(30)
        px.forward(30)
        time.sleep(0.5)
        px.stop()
    elif key == 'i':
        n += 10
        px.set_cam_tilt_angle(n)
    elif key == 'k':
        n -= 10
        px.set_cam_tilt_angle(n)
    elif key == 'j':
        n -= 10
        px.set_cam_pan_angle(n)
    elif key == 'l':
        n += 10
        px.set_cam_pan_angle(n)
    elif key == 'q':
        Vilib.camera_stop()
        break
    else:
        px.stop()
