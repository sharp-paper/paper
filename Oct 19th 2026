from picarx import Picarx
import time
import readchar  
import vilib
# Picarx object
px = Picarx()
pan_angle=0
tilt_angle=0
px.set_cam_pan_angle(pan_angle)
px.set_cam_tilt_angle(tilt_angle)
try:
    try:
       vilib.vilib.camera_start(vflip=False, hflip=False)
    except AttributeError:
       vilib.camera_start(vflip=False, hflip=False)
    while True:
        key = readchar.readkey().lower()
        
        if key == 'w':
            print(">>> forward")
            px.set_dir_servo_angle(0)  
            px.forward(50)
            time.sleep(0.5)           
            px.stop()
            
        elif key == 's':
            print(">>> backward")
            px.set_dir_servo_angle(0)  
            px.backward(50)
            time.sleep(0.5)
            px.stop()
            
        elif key == 'a':
            print(">>> left!")
            px.set_dir_servo_angle(-60)
            px.forward(20) 
            time.sleep(0.5)
            px.stop()          
            
        elif key == 'd':
            print(">>> right!")
            px.set_dir_servo_angle(60)  

